+    count=0
+    for line in vectors.read_text().splitlines():
+        row=json.loads(line);k=row['ordinal'];assert int(oracle[k])==k==layout.ordinal(row['indices']);assert tuple(row['indices'])==layout.indices(k);count+=1
+    assert count==16384
