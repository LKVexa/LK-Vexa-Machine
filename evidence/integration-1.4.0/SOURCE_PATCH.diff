+                DispatcherTimer timer = new DispatcherTimer(DispatcherPriority.Background);
+                timer.Interval = TimeSpan.FromMilliseconds(25);
+                timer.Tick += delegate { timer.Stop(); frame.Continue = false; };
+                timer.Start();
+                Dispatcher.PushFrame(frame);
+            }
+        }
