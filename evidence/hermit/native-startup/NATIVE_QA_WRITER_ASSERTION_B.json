{"connection":"Online","dom":"\u003chtml lang=\"en\"\u003e\u003chead\u003e\u003cmeta http-equiv=\"Content-Security-Policy\" content=\"default-src \u0027none\u0027; script-src \u0027self\u0027; worker-src \u0027self\u0027; style-src \u0027self\u0027; img-src \u0027self\u0027 blob: data:; connect-src \u0027none\u0027; object-src \u0027none\u0027; base-uri \u0027none\u0027; form-action \u0027none\u0027\"\u003e\u003cmeta name=\"referrer\" content=\"no-referrer\"\u003e\u003cmeta charset=\"utf-8\"\u003e\u003cmeta name=\"viewport\" content=\"width=device-width,initial-scale=1\"\u003e\u003cmeta name=\"color-scheme\" content=\"dark\"\u003e\u003ctitle\u003eJA21 Silicon Console 2.4.0\u003c/title\u003e\u003clink rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\"\u003e\u003clink rel=\"stylesheet\" href=\"/style.css\"\u003e\u003cscript type=\"module\" src=\"/src/app.js\"\u003e\u003c/script\u003e\u003c/head\u003e\n\u003cbody\u003e\n\u003cheader\u003e\u003cdiv class=\"identity\"\u003e\u003cspan class=\"mark\"\u003e◆\u003c/span\u003e\u003cdiv\u003e\u003cstrong\u003eJA21 \u003cspan class=\"muted\"\u003e/\u003c/span\u003e SILICON\u003c/strong\u003e\u003csmall\u003eCOMPUTING CONSOLE · \u003cspan id=\"version\"\u003e2.4.0\u003c/span\u003e\u003c/small\u003e\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"header-right\"\u003e\u003cspan id=\"connection\" class=\"badge\"\u003eOnline\u003c/span\u003e\u003cbutton id=\"power\"\u003ePower off\u003c/button\u003e\u003cbutton id=\"reboot\"\u003eReboot\u003c/button\u003e\u003c/div\u003e\u003c/header\u003e\n\u003cnav aria-label=\"Workspace\"\u003e\u003cbutton class=\"selected\" data-view=\"console\" aria-pressed=\"true\"\u003eConsole\u003c/button\u003e\u003cbutton data-view=\"xpu\" aria-pressed=\"false\"\u003eSemi-sili XPU\u003c/button\u003e\u003cbutton data-view=\"russl\" aria-pressed=\"false\"\u003eTIFF pixel lab\u003c/button\u003e\u003cbutton data-view=\"commands\" aria-pressed=\"false\"\u003eCommand library\u003c/button\u003e\u003cbutton data-view=\"storage\" aria-pressed=\"false\"\u003eVirtual storage\u003c/button\u003e\u003cbutton data-view=\"system\" aria-pressed=\"false\"\u003eSystem \u0026amp; limits\u003c/button\u003e\u003cspan class=\"nav-note\"\u003eLOCAL · CPU + WEBGPU VALIDATION\u003c/span\u003e\u003c/nav\u003e\n\u003cdiv id=\"notice\" role=\"status\" aria-live=\"polite\" hidden=\"\"\u003e\u003c/div\u003e\n\u003cmain\u003e\n\u003csection id=\"console\" class=\"view active\"\u003e\u003cdiv class=\"console-grid\"\u003e\u003cdiv class=\"terminal-card\"\u003e\u003cdiv class=\"toolbar\"\u003e\u003cdiv id=\"tabs\" aria-label=\"Terminal sessions\"\u003e\u003cbutton class=\"\"\u003eXPU 1\u003c/button\u003e\u003cbutton class=\"close-tab\" aria-label=\"Close XPU 1\"\u003e×\u003c/button\u003e\u003cbutton class=\"current\"\u003eXPU 2\u003c/button\u003e\u003cbutton class=\"close-tab\" aria-label=\"Close XPU 2\"\u003e×\u003c/button\u003e\u003c/div\u003e\u003cbutton id=\"add-tab\" aria-label=\"Open XPU terminal\"\u003e+ XPU\u003c/button\u003e\u003cbutton id=\"add-ws-tab\" disabled=\"\"\u003e+ WebSocket\u003c/button\u003e\u003cbutton id=\"add-admin-tab\"\u003eAdministrator PowerShell\u003c/button\u003e\u003c/div\u003e\u003cdiv id=\"terminal-container\"\u003e\u003ccanvas tabindex=\"0\" aria-label=\"Terminal 1; command input is below\" width=\"910\" height=\"570\" style=\"display: none; width: 728px; height: 456px;\" hidden=\"\"\u003e\u003c/canvas\u003e\u003ccanvas tabindex=\"0\" aria-label=\"Terminal 2; command input is below\" width=\"650\" height=\"498\" style=\"display: block; width: 520px; height: 399px;\"\u003e\u003c/canvas\u003e\u003c/div\u003e\u003cform id=\"command-form\" autocomplete=\"off\"\u003e\u003clabel for=\"command\"\u003e›\u003c/label\u003e\u003cinput id=\"command\" aria-label=\"Command\" placeholder=\"Type help, xpu info, or hpu bytes\" maxlength=\"4096\" spellcheck=\"false\"\u003e\u003cbutton type=\"submit\"\u003eRun\u003c/button\u003e\u003cbutton id=\"interrupt\" type=\"button\"\u003eInterrupt\u003c/button\u003e\u003c/form\u003e\u003cdiv class=\"terminal-footer\"\u003e\u003cspan id=\"session-status\"\u003eWaiting for worker\u003c/span\u003e\u003cspan id=\"terminal-boundary\"\u003eXPU · virtual files and numerical commands\u003c/span\u003e\u003c/div\u003e\u003cdiv class=\"terminal-footer\"\u003e\u003cspan id=\"network-status\"\u003ePrivate RAM connection\u003c/span\u003e\u003cbutton id=\"reconnect-ws\" disabled=\"\"\u003eReconnect WebSocket\u003c/button\u003e\u003c/div\u003e\u003cp id=\"terminal-help\" class=\"fine\" hidden=\"\"\u003eAdministrator commands run on Windows. Delegate with \u003ccode\u003eInvoke-JA21Terminal -Terminal 1 -Command \u0027xpu info\u0027\u003c/code\u003e or target terminal 2. Results return after the XPU command finishes; interrupted connections never replay work.\u003c/p\u003e\u003cspan id=\"terminal-announcement\" class=\"sr-only\" role=\"status\" aria-live=\"polite\"\u003eXPU 2 selected\u003c/span\u003e\u003c/div\u003e\u003caside class=\"processor-card\"\u003e\u003cdiv class=\"eyebrow\"\u003eFIELD PROCESSOR\u003c/div\u003e\u003ch1\u003eSoftware XPU\u003c/h1\u003e\u003cp class=\"muted\"\u003e64 × 64 complex field · JavaScript CPU\u003c/p\u003e\u003cdiv class=\"field-pair\"\u003e\u003cfigure\u003e\u003ccanvas id=\"phase\" width=\"64\" height=\"64\" aria-label=\"Simulated phase field\"\u003e\u003c/canvas\u003e\u003cfigcaption\u003ePHASE / TIFF\u003c/figcaption\u003e\u003c/figure\u003e\u003cfigure\u003e\u003ccanvas id=\"intensity\" width=\"64\" height=\"64\" aria-label=\"Simulated intensity field\"\u003e\u003c/canvas\u003e\u003cfigcaption\u003eINTENSITY / GIF\u003c/figcaption\u003e\u003c/figure\u003e\u003c/div\u003e\u003cdl class=\"metrics\"\u003e\u003cdiv\u003e\u003cdt\u003eOperation\u003c/dt\u003e\u003cdd id=\"operation\"\u003ebyte chip\u003c/dd\u003e\u003c/div\u003e\u003cdiv\u003e\u003cdt\u003eSpool\u003c/dt\u003e\u003cdd id=\"spool\"\u003e0 / 24\u003c/dd\u003e\u003c/div\u003e\u003cdiv\u003e\u003cdt\u003ePropagation\u003c/dt\u003e\u003cdd id=\"z\"\u003e0.00 mm\u003c/dd\u003e\u003c/div\u003e\u003cdiv\u003e\u003cdt\u003eExecution\u003c/dt\u003e\u003cdd\u003eCPU field model · GPU check in XPU lab\u003c/dd\u003e\u003c/div\u003e\u003c/dl\u003e\u003cdiv class=\"actions\"\u003e\u003cbutton data-command=\"hpu cycle\"\u003eRun cycle\u003c/button\u003e\u003cbutton data-command=\"hpu bytes\"\u003eRun byte lanes\u003c/button\u003e\u003cbutton data-command=\"hpu gate xor 1 0\"\u003eTest XOR\u003c/button\u003e\u003cbutton data-command=\"hpu reset\"\u003eReset field\u003c/button\u003e\u003cbutton data-command=\"hpu tiff\"\u003eExport TIFF to VFS\u003c/button\u003e\u003cbutton data-command=\"hpu gif\"\u003eExport GIF to VFS\u003c/button\u003e\u003c/div\u003e\u003cp class=\"fine\"\u003eLUT equivalence is checked between two software loops. Simulated operations are not hardware FLOPS. TIFF and GIF are data exports, not independently executing processors.\u003c/p\u003e\u003c/aside\u003e\u003c/div\u003e\u003cdetails class=\"transcript\"\u003e\u003csummary\u003eAccessible terminal transcript (current screen)\u003c/summary\u003e\u003cpre id=\"transcript\" aria-live=\"off\"\u003e          ╲  ┆  ╱              Software server · hermit.vws.v3 ·\n        ▪ ┄┄ ◆ ┄┄ ▪            SPIRAL · IndexedDB virtual volume\n          ╱  ┆  ╲              JA21 shell · no physical XPU attac\n        ▪      ▪      ▪\n  ⌞                                                        ⌟\n\n  Type help · disk · image verify · poweroff keeps this volume\n\noperator@virtual0 ~ › echo qa_461765a2ea_begin_3; cat /tmp/webvie\n\\n\u0027; echo qa_461765a2ea_done_3\nqa_461765a2ea_begin_3\ncommitted_webview_value\n\nqa_461765a2ea_done_3\noperator@virtual0 ~ ›\u003c/pre\u003e\u003c/details\u003e\u003c/section\u003e\n\u003csection id=\"russl\" class=\"view\"\u003e\u003cdiv class=\"section-heading\"\u003e\u003cdiv class=\"eyebrow\"\u003eRUSSL CORPUS 2.0.0 · SCOPED PIXEL ADAPTER\u003c/div\u003e\u003ch1\u003eOne field. Every pixel addressed.\u003c/h1\u003e\u003cp\u003e4 × 4 × 4 × 16 × 16 scalar sites, stored in a 128 × 128 Float64 TIFF atlas. Capture and edit a staged image; only Apply changes the live XPU.\u003c/p\u003e\u003c/div\u003e\n\u003cdiv class=\"storage-actions\"\u003e\u003cbutton id=\"russl-capture\"\u003eCapture live field\u003c/button\u003e\u003cbutton id=\"russl-refresh\"\u003eRefresh\u003c/button\u003e\u003cbutton id=\"russl-export\"\u003eDownload field TIFF\u003c/button\u003e\u003cbutton id=\"russl-import\"\u003eImport field TIFF…\u003c/button\u003e\u003cbutton id=\"russl-apply\"\u003eApply to live XPU…\u003c/button\u003e\u003cbutton id=\"russl-receipt\"\u003eDownload SHA-256 receipt\u003c/button\u003e\u003cinput type=\"file\" id=\"russl-file\" accept=\".tif,.tiff,image/tiff\" hidden=\"\"\u003e\u003c/div\u003e\n\u003cp id=\"russl-status\" role=\"status\" class=\"fine\"\u003eRefresh to inspect the staged TIFF.\u003c/p\u003e\n\u003cdiv class=\"system-grid\"\u003e\u003carticle\u003e\u003ch2\u003eInspect or edit a scalar site\u003c/h2\u003e\u003cp\u003ec4 selects real (0), imaginary (1), intensity (2), or phase (3). c5/c6 select a 16 × 16 tile; c7/c8 select its row/column. Intensity and phase are read-only derivatives.\u003c/p\u003e\u003cform id=\"russl-site-form\"\u003e\u003cdiv class=\"russl-indices\"\u003e\n\u003clabel\u003ec4 \u003cinput id=\"russl-c4\" type=\"number\" min=\"0\" max=\"3\" step=\"1\" value=\"0\" required=\"\"\u003e\u003c/label\u003e\u003clabel\u003ec5 \u003cinput id=\"russl-c5\" type=\"number\" min=\"0\" max=\"3\" step=\"1\" value=\"0\" required=\"\"\u003e\u003c/label\u003e\u003clabel\u003ec6 \u003cinput id=\"russl-c6\" type=\"number\" min=\"0\" max=\"3\" step=\"1\" value=\"0\" required=\"\"\u003e\u003c/label\u003e\u003clabel\u003ec7 \u003cinput id=\"russl-c7\" type=\"number\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" required=\"\"\u003e\u003c/label\u003e\u003clabel\u003ec8 \u003cinput id=\"russl-c8\" type=\"number\" min=\"0\" max=\"15\" step=\"1\" value=\"0\" required=\"\"\u003e\u003c/label\u003e\u003c/div\u003e\u003cdiv class=\"russl-edit-row\"\u003e\u003clabel\u003eNew real/imaginary value \u003cinput id=\"russl-value\" type=\"number\" min=\"-1000000000000\" max=\"1000000000000\" step=\"any\" value=\"0.5\"\u003e\u003c/label\u003e\u003cbutton type=\"submit\"\u003eRead site\u003c/button\u003e\u003cbutton id=\"russl-edit\" type=\"button\"\u003eWrite staged pixel\u003c/button\u003e\u003c/div\u003e\u003c/form\u003e\u003cpre id=\"russl-site-output\" class=\"russl-output\"\u003eNo site selected.\u003c/pre\u003e\u003cp class=\"fine\"\u003eEdits round explicitly to the existing XPU\u0027s Float32 precision and report the effective value. Intensity and phase are recalculated together. Your live XPU stays unchanged until Apply.\u003c/p\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eField record\u003c/h2\u003e\u003cpre id=\"russl-summary\" class=\"russl-output\"\u003eNo staged TIFF loaded.\u003c/pre\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eSample-exact versus visual exports\u003c/h2\u003e\u003cp\u003eThe atlas stores real and imaginary Float32 samples widened exactly into Float64 slots, plus derived intensity and phase. No pixels are padding. Ordinary phase.tif remains a quantized unsigned 16-bit visualization and now declares that loss in its metadata.\u003c/p\u003e\u003cp\u003eApplying an atlas resets the GIF spool, recordings, byte lanes, counters and derived caches. Export a full volume backup before replacing a session you need to retain.\u003c/p\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eFormat and execution boundary\u003c/h2\u003e\u003cp\u003eBounded, finite grayscale TIFF: little/big endian, classic TIFF or small BigTIFF, uncompressed strips. Atlas imports require the exact declared placement profile and matching sample checksum. Unsupported metadata, compression or page stacking is rejected.\u003c/p\u003e\u003cp\u003eThe corpus\u0027s language, mechanics and OME-Zarr proposals remain separate. This adapter does not execute metadata or turn TIFF pixels into independent silicon, optical hardware, or a complete RUSSL/MSSL runtime.\u003c/p\u003e\u003c/article\u003e\u003c/div\u003e\u003c/section\u003e\n\u003csection id=\"xpu\" class=\"view\"\u003e\u003cdiv class=\"section-heading\"\u003e\u003cdiv class=\"eyebrow\"\u003eRAM-RESIDENT PHASE AND NEURON PIPELINE\u003c/div\u003e\u003ch1\u003eSemi-sili XPU\u003c/h1\u003e\u003cp\u003eSample the live field, evolve a finite p-adic neuron bank, then read its numerical phase. GPU-required runs confirm every arithmetic result through WebGPU before Save is enabled.\u003c/p\u003e\u003c/div\u003e\n\u003cdiv class=\"system-grid\"\u003e\u003carticle\u003e\u003ch2\u003eRun a checked preview\u003c/h2\u003e\u003cform id=\"xpu-form\"\u003e\u003cdiv class=\"russl-indices\"\u003e\n\u003clabel\u003ePrime \u003cselect id=\"xpu-prime\"\u003e\u003coption value=\"2\"\u003e2\u003c/option\u003e\u003coption value=\"3\"\u003e3\u003c/option\u003e\u003coption value=\"5\"\u003e5\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\n\u003clabel\u003ePrecision \u003cinput id=\"xpu-precision\" type=\"number\" min=\"1\" max=\"16\" step=\"1\" value=\"8\" required=\"\"\u003e\u003c/label\u003e\n\u003clabel\u003eOperation \u003cselect id=\"xpu-operation\"\u003e\u003coption value=\"add\"\u003eAdd\u003c/option\u003e\u003coption value=\"sub\"\u003eSubtract\u003c/option\u003e\u003coption value=\"mul\"\u003eMultiply\u003c/option\u003e\u003coption value=\"negate\"\u003eNegate\u003c/option\u003e\u003coption value=\"complement\"\u003eDigit complement\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\n\u003clabel\u003eOperand \u003cinput id=\"xpu-operand\" type=\"number\" min=\"0\" max=\"65535\" step=\"1\" value=\"1\" required=\"\"\u003e\u003c/label\u003e\n\u003clabel\u003eNeuron steps \u003cinput id=\"xpu-steps\" type=\"number\" min=\"1\" max=\"32\" step=\"1\" value=\"4\" required=\"\"\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cdiv class=\"russl-edit-row\"\u003e\u003clabel\u003eInput \u003cselect id=\"xpu-source\"\u003e\u003coption value=\"field\"\u003eSample live field\u003c/option\u003e\u003coption value=\"bank\"\u003eContinue saved bank\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003clabel\u003eValidation \u003cselect id=\"xpu-mode\"\u003e\u003coption value=\"gpu\"\u003eRequire hardware GPU confirmation\u003c/option\u003e\u003coption value=\"cpu\"\u003eCPU preview and validation\u003c/option\u003e\u003c/select\u003e\u003c/label\u003e\u003c/div\u003e\n\u003cp class=\"fine\"\u003eThe modulus prime raised to precision must be at most 65,536. The operand must be smaller than that modulus. Negation and digit complement are separate operations.\u003c/p\u003e\n\u003cbutton type=\"submit\"\u003eRun preview\u003c/button\u003e\u003cbutton id=\"xpu-cancel\" type=\"button\" disabled=\"\"\u003eCancel run\u003c/button\u003e\u003cbutton id=\"xpu-apply\" type=\"button\" disabled=\"\"\u003eSave result\u003c/button\u003e\u003c/form\u003e\n\u003cp id=\"xpu-status\" role=\"status\"\u003eNo run yet.\u003c/p\u003e\u003cp id=\"xpu-saved\" class=\"fine\"\u003eNo saved neuron bank.\u003c/p\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eSampled preview\u003c/h2\u003e\u003cdiv class=\"field-pair\"\u003e\u003cfigure\u003e\u003ccanvas id=\"xpu-phase\" width=\"64\" height=\"64\" aria-label=\"Checked numerical phase preview\"\u003e\u003c/canvas\u003e\u003cfigcaption\u003ePHASE\u003c/figcaption\u003e\u003c/figure\u003e\u003cfigure\u003e\u003ccanvas id=\"xpu-intensity\" width=\"64\" height=\"64\" aria-label=\"Numerical neuron amplitude preview\"\u003e\u003c/canvas\u003e\u003cfigcaption\u003eINTENSITY\u003c/figcaption\u003e\u003c/figure\u003e\u003c/div\u003e\u003cp\u003eThe CPU models wave phases and finite neuron evolution. GPU confirmation covers exact ring arithmetic. Saving publishes the checked Float32 field and its neuron bank together.\u003c/p\u003e\u003cp class=\"fine\"\u003eNeuron amplitude is a numerical coupling. Quantum, optical and physical in-DRAM operations are research models; this pipeline uses the laptop\u0027s existing CPU and available GPU.\u003c/p\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eKeep and inspect a result\u003c/h2\u003e\u003cdiv class=\"storage-actions\"\u003e\u003cbutton id=\"xpu-refresh\"\u003eRefresh saved bank\u003c/button\u003e\u003cbutton id=\"xpu-export\"\u003eDownload Pixel160 TIFF\u003c/button\u003e\u003cbutton id=\"xpu-import\"\u003eImport Pixel160 TIFF…\u003c/button\u003e\u003cbutton id=\"xpu-receipt\"\u003eDownload run receipt\u003c/button\u003e\u003cinput type=\"file\" id=\"xpu-file\" accept=\".tif,.tiff,image/tiff\" hidden=\"\"\u003e\u003c/div\u003e\u003cp\u003eEach logical cell has five exact 32-bit words: residue, activation, amplitude, real field and imaginary field. A TIFF byte raster retains those 20 bytes; the five logical coordinate axes are declared in its metadata.\u003c/p\u003e\u003cp class=\"fine\"\u003eUp to eight prior frames are retained in the saved bank. TIFF carries one frame. Imported files are checked before Save; their old GPU status is never treated as a fresh measurement. Export a full volume backup from Virtual storage.\u003c/p\u003e\u003c/article\u003e\n\u003carticle\u003e\u003ch2\u003eRun receipt\u003c/h2\u003e\u003cpre id=\"xpu-results\" class=\"russl-output\"\u003eNo run yet.\u003c/pre\u003e\u003c/article\u003e\u003c/div\u003e\u003c/section\u003e\n\u003csection id=\"commands\" class=\"view\"\u003e\u003cdiv class=\"section-heading\"\u003e\u003cdiv class=\"eyebrow\"\u003eREFERENCE\u003c/div\u003e\u003ch1\u003eEvery command, one place.\u003c/h1\u003e\u003cp\u003eSearch the live registry. “Insert” fills the command line without executing anything.\u003c/p\u003e\u003c/div\u003e\u003cinput type=\"search\" id=\"search-commands\" placeholder=\"Search names, descriptions, or usage\" aria-label=\"Search commands\"\u003e\u003cdiv id=\"command-count\" class=\"fine\"\u003e62 of 62 commands\u003c/div\u003e\u003cdiv id=\"command-list\" class=\"command-list\"\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003eabout\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003eshow the HERMIT / SPIRAL architecture\u003c/p\u003e\u003ccode\u003eabout\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ealias\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003edefine or list command aliases\u003c/p\u003e\u003ccode\u003ealias [name=value ...]\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ebrowser\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003econtrol the embedded browser pane\u003c/p\u003e\u003ccode\u003ebrowser \u0026lt;open|go|close|info\u0026gt; [url]\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ecat\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003econcatenate files and print\u003c/p\u003e\u003ccode\u003ecat [-n] [file...]\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ecd\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003echange the working directory\u003c/p\u003e\u003ccode\u003ecd [dir]\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003eclear\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003eclear the terminal screen\u003c/p\u003e\u003ccode\u003eclear\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ecp\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003ecopy files\u003c/p\u003e\u003ccode\u003ecp src dst\u003c/code\u003e\u003c/article\u003e\u003carticle class=\"command-entry\"\u003e\u003ch2\u003ecxl\u003cbutton\u003eInsert\u003c/button\u003e\u003c/h2\u003e\u003cp\u003eshow this server\u0027s memory window as hot and warm tiers\u003c/p\u003e\u003ccode\u003ecxl [sta